// This schema intentionally covers only the small, fixed set of products
// `fingerprintStack` can passively detect (see packages/db/src/product-catalog.ts) — not the
// full NVD corpus. The sync job pulls CVEs by keyword/CPE for those products specifically.

// Prisma 7 moved the connection URL out of the schema and into prisma.config.ts (used by the
// CLI/Migrate) plus an explicit driver adapter passed to `new PrismaClient()` at runtime (see
// src/client.ts) — there's no `url = env(...)` here anymore because Prisma 7 no longer reads it.
datasource db {
  provider = "postgresql"
}

// Generated into src/ (not a sibling generated/ dir) so it stays under tsconfig's rootDir and
// can be imported/compiled like any other source file.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Cve {
  id           String   @id // e.g. "CVE-2023-5877"
  description  String
  severity     Severity
  baseScore    Float
  published    DateTime
  lastModified DateTime
  syncedAt     DateTime @updatedAt

  affected CveAffectedProduct[]

  @@index([severity, published])
}

/// One row per CPE match-criteria entry a CVE lists for a product we track — a single CVE can
/// affect several version ranges of the same product (e.g. one fixed range per branch).
model CveAffectedProduct {
  id    String @id @default(cuid())
  cveId String
  cve   Cve    @relation(fields: [cveId], references: [id], onDelete: Cascade)

  /// Our own catalog key (see product-catalog.ts), not the raw CPE string — e.g. "nginx".
  productKey String

  versionStartIncluding String?
  versionStartExcluding String?
  versionEndIncluding   String?
  versionEndExcluding   String?
  /// Set instead of the range fields when the CPE criteria pins one exact version.
  exactVersion          String?

  @@index([productKey])
}

/// Tracks per-product sync progress so the scheduled job can report/debug failures; the actual
/// pull strategy re-queries each product's full (bounded) CVE set on every run rather than
/// diffing incrementally — see the sync job for why that's an acceptable simplification here.
model CveSyncState {
  productKey   String    @id
  lastSyncedAt DateTime?
  lastStatus   String?
  lastError    String?
}

enum DomainVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
  /// A domain that WAS verified but has passed its 90-day verificationExpiresAt without being
  /// re-verified. Kept distinct from UNVERIFIED so the record still shows it was once proven —
  /// see the scheduled expiry job in packages/workers/src/domain-verification-expiry.
  EXPIRED
}

/// Which ownership-proof mechanism a verification attempt used — see
/// packages/scanners/src/domain-verification. Both prove the same thing (control over the
/// domain's DNS zone or web server); which one a given owner can complete is just a matter of
/// what access they have.
enum DomainVerificationMethod {
  DNS_TXT
  WELL_KNOWN_FILE
}

/// Gates access to any scan check more assertive than the passive checks in packages/scanners —
/// only ever set to AUTHENTICATED by a successful verification check
/// (packages/db/src/domain-verification-repository.ts), and only ever reset to PASSIVE by a
/// failed re-verification or the scheduled expiry job.
enum ScanTier {
  PASSIVE
  AUTHENTICATED
}

/// A domain the product knows about, independent of any single scan. `verificationStatus`
/// tracks whether whoever registered this domain has proven ownership of it via the DNS TXT or
/// well-known-file challenge in packages/scanners/src/domain-verification.
/// `verificationToken`/`verificationMethod` describe the current (or most recent) challenge;
/// `verificationExpiresAt` is when a successful verification stops counting — ownership proof
/// isn't permanent, since domains change hands.
model Domain {
  id                    String                    @id @default(cuid())
  /// Stored lowercased (DNS names are case-insensitive) so "Example.com" and "example.com"
  /// can't create two rows — enforced in scan-report-repository.ts, not at the DB level, since
  /// Postgres has no case-insensitive unique constraint without a functional index.
  domain                String                    @unique
  verificationStatus    DomainVerificationStatus  @default(UNVERIFIED)
  verificationMethod    DomainVerificationMethod?
  verificationToken     String?
  verifiedAt            DateTime?
  /// Set to verifiedAt + 90 days on successful verification; null until the first success.
  /// Re-verifying (successfully) before this passes just pushes it forward another 90 days.
  verificationExpiresAt DateTime?
  scanTier              ScanTier                  @default(PASSIVE)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  scanReports ScanReport[]

  @@index([verificationStatus, verificationExpiresAt])
}

enum LetterGrade {
  A
  B
  C
  D
  F
}

/// One row per completed `scoreReport()` run for a domain, kept forever (never overwritten) so
/// `scannedAt` versions a full history per domain and trends can be charted later. `domain` is
/// modeled as a relation rather than a bare string column, matching `CveAffectedProduct.cve`'s
/// pattern elsewhere in this schema — it's what makes "show historical trends per domain"
/// (querying `Domain.scanReports` ordered by `scannedAt`) a normal indexed query instead of a
/// string-matching scan.
model ScanReport {
  id       String @id @default(cuid())
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  scannedAt DateTime

  /// The raw typed scanner outputs passed into `scoreReport()` (`ScanResults` from
  /// @janus/scanners: tls/headers/dns/fingerprint), stored as-is for later re-scoring or audit
  /// if the grading logic changes.
  rawResults Json

  /// The full `ScoreReport` object `scoreReport()` returned (per-category scores/grades,
  /// overall score, disclaimer). `overallGrade` and `overallScore` below duplicate two fields
  /// out of this JSON so trend queries (chart overall score/grade over time for a domain) don't
  /// need to parse JSON in application code or in SQL.
  computedScore Json
  overallGrade  LetterGrade
  overallScore  Int

  createdAt DateTime @default(now())

  @@index([domainId, scannedAt])
}

/// A complaint submitted via POST /abuse-report — e.g. "stop scanning my site" or "your scanner
/// is hitting my server too hard". Deliberately *not* linked to the Domain model: a report must
/// be accepted even for a domain we've never scanned or stored a row for, and this is a
/// manual-review queue, not scan-eligibility state — the DNS opt-out record (see
/// packages/shared/src/scan-target/check-opt-out.ts) is what actually blocks future scans;
/// this table exists for the cases someone can't or hasn't added that record yet.
model AbuseReport {
  id      String  @id @default(cuid())
  domain  String
  reason  String
  details String?
  /// Optional so a report can't be blocked on providing contact info, but present when the
  /// reporter wants a reply.
  contact String?

  createdAt DateTime @default(now())

  @@index([domain])
}

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  ACCEPTABLE_USE_POLICY
}

/// A timestamped changelog entry for one of our legal documents — the actual document text
/// lives in the frontend (packages/frontend/app/terms, /acceptable-use, /privacy), not here;
/// this table exists so `LegalAcceptance`/`ScanConsent` rows can point at exactly which
/// version was in effect when someone agreed to it or attested to scanning authorization,
/// which is the whole point per Prompt 9: proving what a user agreed to if it's ever disputed.
/// ALL current rows are placeholder-text versions — see LEGAL_REVIEW.md.
model LegalVersion {
  id           String            @id @default(cuid())
  documentType LegalDocumentType
  /// e.g. "1.0.0-placeholder" — free-form, not semver-enforced.
  version      String
  /// What changed in this version, for our own history — not shown to end users.
  changeNote   String?
  effectiveAt  DateTime
  createdAt    DateTime          @default(now())

  scanConsents     ScanConsent[]
  legalAcceptances LegalAcceptance[]

  @@unique([documentType, version])
  /// Every "current version" lookup is "latest effectiveAt for this documentType" — see
  /// getCurrentLegalVersion in packages/db/src/legal-repository.ts.
  @@index([documentType, effectiveAt])
}

/// One row per scan submission's "I own this domain or have authorization to assess it"
/// attestation (see POST /scans in packages/api/src/routes/scans.ts) — the audit trail if a
/// scanned domain's owner ever disputes being scanned without authorization.
///
/// `userId` is deliberately nullable and, as of Prompt 9, always null: scan submission is
/// anonymous by design (see Prompt 5/7's decision, reaffirmed in Prompt 9's scoping) — there is
/// no Clerk session on this route, and adding one would reintroduce exactly the "a Clerk
/// misconfiguration must not be able to take down scanning" risk that decision was built to
/// avoid. If scan submission ever becomes account-gated, this is where that user ID would go;
/// until then, `requesterIp` + `attestedAt` + `targetDomain` is the identifying tuple.
model ScanConsent {
  id           String   @id @default(cuid())
  userId       String?
  requesterIp  String
  targetDomain String
  attestedAt   DateTime @default(now())

  /// The exact Acceptable Use Policy version the attestation checkbox text corresponded to at
  /// submission time.
  acceptableUseVersionId String
  acceptableUseVersion   LegalVersion @relation(fields: [acceptableUseVersionId], references: [id])

  @@index([targetDomain])
  @@index([attestedAt])
}

/// One row per (user, document type, version) a user has agreed to — e.g. clicking "I agree" on
/// the Terms of Service before starting domain-ownership verification (the only account-tied
/// action in this app as of Prompt 9; see requireLegalAcceptance in
/// packages/api/src/plugins/legal.ts). `userId` is the Clerk user ID — this app has no local
/// User table, Clerk owns identity, this just records app-specific consent against that ID.
model LegalAcceptance {
  id             String            @id @default(cuid())
  userId         String
  documentType   LegalDocumentType
  legalVersionId String
  legalVersion   LegalVersion      @relation(fields: [legalVersionId], references: [id])
  acceptedAt     DateTime          @default(now())
  ipAddress      String

  @@unique([userId, documentType, legalVersionId])
  @@index([userId])
}
