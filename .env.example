NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Local Postgres/Redis via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL=postgresql://janus:janus@localhost:5433/janus
REDIS_URL=redis://localhost:6379

# Identifies outbound scan requests to the site being scanned. Required — customize the URL
# before deploying anywhere real users can reach it.
SCANNER_USER_AGENT=JanusSecurityScanner/1.0 (+https://example.com/about-scans)

# Optional — raises the NVD CVE sync job's rate limit from 5 to 50 requests per 30 seconds.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Clerk (https://dashboard.clerk.com) — required, no default. Get these from your Clerk
# application's Configure > API Keys page.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated exact origins allowed to call this API cross-origin. No wildcard support —
# empty (the default) rejects every cross-origin request. For local frontend dev this is
# typically http://localhost:3001 (see packages/frontend/package.json's dev script).
CORS_ALLOWED_ORIGINS=
