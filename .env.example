NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Local Postgres/Redis via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL=postgresql://janus:janus@localhost:5433/janus
REDIS_URL=redis://localhost:6379

# Identifies outbound scan requests to the site being scanned. Required — customize the URL
# before deploying anywhere real users can reach it.
SCANNER_USER_AGENT=JanusSecurityScanner/1.0 (+https://example.com/about-this-scanner)

# Optional — raises the NVD CVE sync job's rate limit from 5 to 50 requests per 30 seconds.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Clerk (https://dashboard.clerk.com) — required, no default. Get these from your Clerk
# application's Configure > API Keys page.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated exact origins allowed to call this API cross-origin. No wildcard support —
# empty (the default) rejects every cross-origin request. For local frontend dev this is
# typically http://localhost:3001 (see packages/frontend/package.json's dev script).
CORS_ALLOWED_ORIGINS=

# Optional — error tracking via @sentry/node (API/worker) and @sentry/nextjs (frontend). Local
# dev with this unset sends nothing anywhere. Get a DSN from a Sentry project's Settings >
# Client Keys page. See README.md's "Error tracking & alerting" section for how to configure
# actual alert rules once a project exists — that's a Sentry-dashboard step, not an env var.
# SENTRY_DSN=
#
# Frontend-only, same DSN value but NEXT_PUBLIC_-prefixed so it's readable in the browser
# bundle (see packages/frontend/instrumentation-client.ts). Set in packages/frontend/.env.local,
# not this root .env — see that package's own env handling.
# NEXT_PUBLIC_SENTRY_DSN=
#
# Optional — only needed if uploading source maps to Sentry at build time (org/project slugs
# plus a SENTRY_AUTH_TOKEN, not stored here). Without these the build still succeeds; Sentry's
# webpack/turbopack plugin just skips the upload step.
# SENTRY_ORG=
# SENTRY_PROJECT=

# Optional, default 12 — how many months of scan records and consent/IP-log records the daily
# data-retention job keeps before deleting them. See packages/workers/src/data-retention.
# RETENTION_MONTHS=12

# Frontend-only — gates the entire site behind a single shared password (see
# packages/frontend/middleware.ts). Set in packages/frontend's own env (Vercel project
# settings, or packages/frontend/.env.local for local dev), not this root .env. Unset means no
# gate (open access) — that is the local dev default.
# SITE_PASSWORD=
